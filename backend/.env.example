# ---- app ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- database / redis ----
DATABASE_URL=postgresql+psycopg2://think9:think9@localhost:5432/think9
REDIS_URL=redis://localhost:6379/0

# ---- embeddings ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# ---- LLM tiers ----
CHEAP_MODEL=gpt-4o-mini
CHEAP_PROVIDER=openai
PREMIUM_MODEL=claude-sonnet-4-20250514
PREMIUM_PROVIDER=anthropic

# ---- provider keys (set real values locally, never commit) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- retrieval weights (retrieval-system.md §3) ----
HYBRID_W_SEMANTIC=0.50
HYBRID_W_BM25=0.25
HYBRID_W_CATEGORY=0.15
HYBRID_W_FRESHNESS=0.10

# ---- retrieval thresholds ----
RETRIEVE_OK_THRESHOLD=0.55
RETRIEVE_WEAK_THRESHOLD=0.35

# ---- generation ----
CONTEXT_TOKEN_BUDGET=4000
RERANK_TOP_K=40
CONTEXT_TOP_K=12
MAX_REVISION_ROUNDS=2
COST_BUDGET_USD=1.00

# ---- cors ----
CORS_ORIGINS=["http://localhost:3000"]
